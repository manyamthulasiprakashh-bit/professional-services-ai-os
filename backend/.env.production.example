# Production backend environment (template — never commit real values).
#
# Configure these in the Render dashboard (Environment) or an equivalent
# secret manager. Values below are placeholders; replace the bracketed parts
# once the real Render service and Vercel production domain exist.
#
# Local development keeps its own defaults and does not use this file.

# Exact browser origins allowed by credentialed CORS and the CSRF origin
# check. Comma-separated, no wildcards, no paths/trailing slashes. Include the
# Vercel production origin (and any preview origin you deliberately allow).
PS_ALLOWED_ORIGINS=https://<your-vercel-production-origin>

# Production cookies are HTTPS-only. NEVER enable this for local HTTP.
PS_AUTH_COOKIE_SECURE=true

# Persistent storage on a Render PAID disk. Both SQLite and uploaded files must
# live on the same persistent volume; the default repo-relative paths are
# ephemeral on Render. On the Render FREE tier there is no persistent disk:
# omit both variables (leave the defaults) and accept that the account and all
# business data reset on every redeploy/restart/spin-down. Do not point these at
# /var/data without a mounted disk.
PS_APP_DB=/var/data/app.db
PS_DOCS_DIR=/var/data/documents

# Optional: session lifetime in seconds (default 12 hours).
# PS_AUTH_SESSION_TTL=43200

# --- Initial login user (choose one path) ---
# Path A: create the account interactively on a host with a shell:
#   cd backend && python -m scripts.create_user --username <name>
# Path B: environment-driven startup bootstrap (hosts WITHOUT a shell, e.g.
# Render free tier). Set the username plus the PREFERRED password hash. The
# backend creates the user only when the database has zero users, never
# overwrites an existing account, and never logs these values.
# Generate the hash locally (hidden prompt) and paste only the hash here:
#   backend/.venv/bin/python -m scripts.create_user --print-hash
# PS_BOOTSTRAP_USERNAME=<name>
# PS_BOOTSTRAP_PASSWORD_HASH=pbkdf2_sha256$<iterations>$<salt_hex>$<hash_hex>
# Fallback only (used when no hash is set; prefer the hash so the plaintext
# password never lives in the hosting environment):
# PS_BOOTSTRAP_PASSWORD=<12-plus-character-password>

# --- Generation provider (optional) ---
# Default is local Ollama. On a hosted backend Ollama is normally unreachable,
# so set PS_LLM_PROVIDER=openrouter to use hosted generation.
# Never put these in VITE_* variables or commit real values.
# PS_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=<your-backend-only-api-key>
# OPENROUTER_MODEL=<a-model-currently-available-to-your-account>
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=180
#
# Model availability, free offers, limits and terms can change. Hosted
# inference sends the prompt and retrieved context to OpenRouter; use
# fictional demo data unless data-handling terms have been reviewed.

# --- Embeddings (separate from generation) ---
# Embeddings always use Ollama and are never sent to OpenRouter. Without a
# reachable embedding service, semantic retrieval is skipped and keyword
# retrieval still works. Do not point this at localhost in a hosted
# environment.
# OLLAMA_URL=https://<your-ollama-endpoint>
# OLLAMA_EMBED_MODEL=nomic-embed-text
